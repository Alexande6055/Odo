<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fleet_traccar.TransportDashboard" owl="1">
        <div class="o_transport_native_dashboard">
            <!-- HEADER DE CONTROL Y FILTROS -->
            <div class="dashboard-header d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="header-icon-box">
                        <i class="fa fa-bus text-info fs-3"/>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-white">Centro de Mando de Transporte Universitario - UTA</h4>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="live-dot-pulse"/>
                            <span class="text-success fw-bold small">MONITOREO EN VIVO</span>
                            <span class="text-muted small">• Última sincronización: <t t-esc="state.lastUpdated"/></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                    <!-- Selector de Periodo -->
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" 
                                class="btn" 
                                t-att-class="state.period === 'today' ? 'btn-primary' : 'btn-dark border-secondary text-light'"
                                t-on-click="() => this.setPeriod('today')">
                            Hoy
                        </button>
                        <button type="button" 
                                class="btn" 
                                t-att-class="state.period === 'week' ? 'btn-primary' : 'btn-dark border-secondary text-light'"
                                t-on-click="() => this.setPeriod('week')">
                            Esta Semana
                        </button>
                        <button type="button" 
                                class="btn" 
                                t-att-class="state.period === 'all' ? 'btn-primary' : 'btn-dark border-secondary text-light'"
                                t-on-click="() => this.setPeriod('all')">
                            Histórico
                        </button>
                    </div>

                    <!-- Botón de Refresco -->
                    <button class="btn btn-sm btn-outline-info d-flex align-items-center gap-1" 
                            t-on-click="() => this.loadData(false)"
                            title="Sincronizar telemetría ahora">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': state.loading}"/>
                        <span>Actualizar</span>
                    </button>
                </div>
            </div>

            <!-- TARJETAS DE KPIS PRINCIPALES -->
            <div class="row g-2 mb-3">
                <!-- KPI 1: Unidades Activas -->
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="kpi-card border-left-primary">
                        <div class="kpi-label">Buses en Ruta</div>
                        <div class="kpi-value text-primary">
                            <t t-esc="state.kpis.active_vehicles || 0"/>
                            <span class="kpi-subtext">/ <t t-esc="state.kpis.total_vehicles || 0"/> Flota</span>
                        </div>
                        <div class="kpi-meta"><i class="fa fa-tachometer text-primary me-1"/> En operación</div>
                    </div>
                </div>

                <!-- KPI 2: Puntualidad Global -->
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="kpi-card border-left-success">
                        <div class="kpi-label">Puntualidad</div>
                        <div class="kpi-value text-success">
                            <t t-esc="state.kpis.punctuality_rate || 0"/>%
                        </div>
                        <div class="kpi-meta"><i class="fa fa-clock-o text-success me-1"/> Llegadas a tiempo</div>
                    </div>
                </div>

                <!-- KPI 3: Cumplimiento de Rutas -->
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="kpi-card border-left-info">
                        <div class="kpi-label">Cumplimiento Ruta</div>
                        <div class="kpi-value text-info">
                            <t t-esc="state.kpis.route_compliance_rate || 0"/>%
                        </div>
                        <div class="kpi-meta"><i class="fa fa-check-circle text-info me-1"/> Sin desvíos</div>
                    </div>
                </div>

                <!-- KPI 4: Cobertura de Paradas -->
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="kpi-card border-left-warning">
                        <div class="kpi-label">Cobertura Paradas</div>
                        <div class="kpi-value text-warning">
                            <t t-esc="state.kpis.stops_coverage_rate || 0"/>%
                        </div>
                        <div class="kpi-meta"><i class="fa fa-map-marker text-warning me-1"/> Paradas visitadas</div>
                    </div>
                </div>

                <!-- KPI 5: Retraso Promedio -->
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="kpi-card border-left-danger">
                        <div class="kpi-label">Retraso Promedio</div>
                        <div class="kpi-value text-danger">
                            <t t-esc="state.kpis.avg_delay_minutes || 0"/> <span class="fs-6">min</span>
                        </div>
                        <div class="kpi-meta"><i class="fa fa-exclamation-triangle text-danger me-1"/> En tramos</div>
                    </div>
                </div>

                <!-- KPI 6: Kilometraje Total -->
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="kpi-card border-left-purple">
                        <div class="kpi-label">Kilometraje</div>
                        <div class="kpi-value text-purple">
                            <t t-esc="state.kpis.total_km || 0"/> <span class="fs-6">km</span>
                        </div>
                        <div class="kpi-meta"><i class="fa fa-road text-purple me-1"/> Recorrido total</div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN CENTRAL: MAPA EN VIVO DE LA FLOTA (MICROSERVICIO WEB REACT) -->
            <div class="dashboard-panel mb-3">
                <div class="panel-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-globe text-info"/>
                        <span class="fw-bold text-white">Mapa Satelital de Seguimiento en Vivo</span>
                        <span class="badge bg-dark border border-info text-info small ms-1">Telemetría Satelital en Vivo</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <a t-att-href="state.mapWebRawUrl" 
                           target="_blank" 
                           class="btn btn-xs btn-outline-info text-light d-flex align-items-center gap-1"
                           title="Abrir aplicación web de mapas en una pestaña independiente">
                            <i class="fa fa-external-link"/> <span>Abrir App Web</span>
                        </a>
                        <button class="btn btn-xs btn-dashboard-icon ms-1" 
                                t-on-click="reloadMapIframe" 
                                title="Recargar visor de mapas">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                </div>
                <div class="panel-body p-0">
                    <t t-if="state.mapWebUrl">
                        <iframe t-att-src="state.mapWebUrl" 
                                t-ref="mapIframe"
                                class="dashboard-map-canvas" 
                                style="width: 100%; height: 500px; border: none; display: block;" 
                                allow="geolocation">
                        </iframe>
                    </t>
                    <t t-else="">
                        <div class="text-center py-5 text-muted">
                            <i class="fa fa-map-o fs-1 mb-2 d-block text-secondary"/>
                            <p>Cargando microservicio de mapas desde .env...</p>
                        </div>
                    </t>
                </div>
            </div>

            <!-- SECCIÓN DE GRÁFICOS ANALÍTICOS (CHART.JS) -->
            <div class="row g-3 mb-3">
                <!-- Gráfico 1: Cumplimiento de Viajes -->
                <div class="col-12 col-lg-4">
                    <div class="dashboard-panel h-100">
                        <div class="panel-header d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-pie-chart text-info me-2"/>
                                <span class="fw-bold text-white">Cumplimiento de Recorridos</span>
                            </div>
                            <span class="badge bg-dark border border-secondary text-info small">General</span>
                        </div>
                        <div class="panel-body position-relative" style="height: 230px; width: 100%;">
                            <canvas t-ref="complianceChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Gráfico 2: Desempeño por Línea -->
                <div class="col-12 col-lg-4">
                    <div class="dashboard-panel h-100">
                        <div class="panel-header d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-bar-chart text-success me-2"/>
                                <span class="fw-bold text-white">Puntualidad por Línea (%)</span>
                            </div>
                            <span class="badge bg-dark border border-secondary text-success small">Troncales</span>
                        </div>
                        <div class="panel-body position-relative" style="height: 230px; width: 100%;">
                            <canvas t-ref="routesChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Gráfico 3: Incidencias Registradas -->
                <div class="col-12 col-lg-4">
                    <div class="dashboard-panel h-100">
                        <div class="panel-header d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-bell text-danger me-2"/>
                                <span class="fw-bold text-white">Desglose de Incidencias</span>
                            </div>
                            <span class="badge bg-dark border border-secondary text-danger small">Eventos</span>
                        </div>
                        <div class="panel-body position-relative" style="height: 230px; width: 100%;">
                            <canvas t-ref="incidentsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN OPERATIVA: DESPACHO Y ALERTAS EN TIEMPO REAL -->
            <div class="row g-3 mb-3">
                <!-- Tabla de Recorridos del Día -->
                <div class="col-12 col-xl-7">
                    <div class="dashboard-panel h-100">
                        <div class="panel-header d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-list-alt text-primary me-2"/>
                                <span class="fw-bold text-white">Monitoreo de Recorridos y Despacho</span>
                            </div>
                            <span class="badge badge-slate small"><t t-esc="state.recent_trips.length"/> Viajes</span>
                        </div>
                        <div class="panel-body p-0 table-responsive" style="max-height: 320px; overflow-y: auto;">
                            <table class="table table-dark table-hover mb-0 align-middle small">
                                <thead>
                                    <tr class="text-muted border-secondary">
                                        <th>Código</th>
                                        <th>Ruta</th>
                                        <th>Sentido</th>
                                        <th>Vehículo / Bus</th>
                                        <th>Conductor</th>
                                        <th>Salida</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.recent_trips.length">
                                        <tr>
                                            <td colspan="7" class="text-center text-muted py-4">No hay recorridos registrados en este periodo</td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.recent_trips" t-as="trip" t-key="trip.id">
                                        <tr class="cursor-pointer" t-on-click="() => this.openTrip(trip.id)">
                                            <td class="fw-bold text-info"><t t-esc="trip.code"/></td>
                                            <td>
                                                <span class="badge bg-dark border border-secondary text-light me-1"><t t-esc="trip.route_code"/></span>
                                                <span class="d-none d-sm-inline text-truncate"><t t-esc="trip.route_name"/></span>
                                            </td>
                                            <td>
                                                <span t-if="trip.direction === 'outbound'" class="badge bg-primary text-white">Ida</span>
                                                <span t-else="" class="badge bg-warning text-dark">Regreso</span>
                                            </td>
                                            <td><t t-esc="trip.vehicle"/></td>
                                            <td><t t-esc="trip.driver"/></td>
                                            <td><t t-esc="trip.actual_time || trip.scheduled_time"/></td>
                                            <td>
                                                <span t-if="trip.state === 'in_progress'" class="badge bg-info text-white">En Curso</span>
                                                <span t-elif="trip.compliance_status === 'compliant'" class="badge bg-success text-white">Puntual</span>
                                                <span t-elif="trip.compliance_status === 'delayed'" class="badge bg-warning text-dark">+<t t-esc="trip.delay_minutes"/> min</span>
                                                <span t-elif="trip.compliance_status === 'non_compliant'" class="badge bg-danger text-white">No Conforme</span>
                                                <span t-else="" class="badge badge-slate"><t t-esc="trip.state"/></span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Feed de Alertas e Incidencias en Vivo -->
                <div class="col-12 col-xl-5">
                    <div class="dashboard-panel h-100">
                        <div class="panel-header d-flex justify-content-between align-items-center">
                            <div>
                                <i class="fa fa-exclamation-circle text-danger me-2"/>
                                <span class="fw-bold text-white">Alertas e Incidencias Recientes</span>
                            </div>
                            <span class="badge bg-danger text-white small"><t t-esc="state.recent_incidents.length"/> Eventos</span>
                        </div>
                        <div class="panel-body p-2" style="max-height: 320px; overflow-y: auto;">
                            <t t-if="!state.recent_incidents.length">
                                <div class="text-center text-muted py-4">
                                    <i class="fa fa-check-circle text-success fs-1 mb-2 d-block"/>
                                    <span>No se registran anomalías ni desvíos activos.</span>
                                </div>
                            </t>
                            <t t-foreach="state.recent_incidents" t-as="inc" t-key="inc.id">
                                <div class="incident-feed-item mb-2 p-2 rounded cursor-pointer" 
                                     t-att-class="'incident-border-' + (inc.severity || 'low')"
                                     t-on-click="() => this.openIncident(inc.id)">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold small text-white"><t t-esc="inc.name"/></span>
                                        <span class="badge" 
                                              t-att-class="inc.severity === 'high' ? 'bg-danger text-white' : (inc.severity === 'medium' ? 'bg-warning text-dark' : 'bg-info text-dark')">
                                            <t t-esc="inc.severity === 'high' ? 'Grave' : (inc.severity === 'medium' ? 'Media' : 'Baja')"/>
                                        </span>
                                    </div>
                                    <div class="text-muted small mb-1"><t t-esc="inc.description"/></div>
                                    <div class="d-flex justify-content-between small text-secondary">
                                        <span><i class="fa fa-bus me-1"/> <t t-esc="inc.vehicle"/></span>
                                        <span><i class="fa fa-clock-o me-1"/> <t t-esc="inc.time"/></span>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FOOTER DE MÉTRICAS DE CALIDAD (ISO/IEC 25010) -->
            <div class="dashboard-panel">
                <div class="panel-body p-2 d-flex flex-wrap justify-content-around align-items-center text-center small text-muted">
                    <div>
                        <span class="d-block text-secondary">Integridad Datos GPS</span>
                        <strong class="text-success"><t t-esc="state.quality_metrics.gps_integrity || 99.4"/>%</strong>
                    </div>
                    <div>
                        <span class="d-block text-secondary">Servidor Traccar</span>
                        <strong class="text-success"><i class="fa fa-check-circle me-1"/> En Línea</strong>
                    </div>
                    <div>
                        <span class="d-block text-secondary">Latencia de Telemetría</span>
                        <strong class="text-info"><t t-esc="state.quality_metrics.api_latency_ms || 15.0"/> ms</strong>
                    </div>
                    <div>
                        <span class="d-block text-secondary">Refresco Automático</span>
                        <strong class="text-light">Cada 20 segundos</strong>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
