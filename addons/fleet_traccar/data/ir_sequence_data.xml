<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Secuencia para Recorridos / Viajes -->
        <record id="seq_transport_trip" model="ir.sequence">
            <field name="name">Secuencia de Recorridos de Transporte</field>
            <field name="code">transport.trip</field>
            <field name="prefix">VIAJE/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>

