<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA ÁRBOL DE RECORRIDOS (VIAJES) -->
    <record id="view_transport_trip_tree" model="ir.ui.view">
        <field name="name">transport.trip.tree</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <tree string="Recorridos y Viajes de Transporte">
                <field name="name" string="Código"/>
                <field name="trip_direction" string="Sentido" widget="badge" 
                       decoration-info="trip_direction == 'outbound'" 
                       decoration-warning="trip_direction == 'inbound'"/>
                <field name="date" string="Fecha"/>
                <field name="vehicle_id" string="Bus / Unidad"/>
                <field name="driver_id" string="Conductor" optional="show"/>
                <field name="route_id" string="Ruta"/>
                <field name="scheduled_start_hour" string="Salida Prog." widget="float_time"/>
                <field name="actual_start_hour" string="Salida Real" widget="float_time" optional="hide"/>
                <field name="duration_real_minutes" string="Duración (min)" optional="hide"/>
                <field name="actual_distance" string="Distancia (km)" optional="hide"/>
                <field name="delay_minutes" string="Retraso (min)"/>
                <field name="stop_completion_rate" string="% Paradas" widget="progressbar"/>
                <field name="state" string="Estado" widget="badge" 
                       decoration-muted="state == 'draft'" 
                       decoration-info="state == 'in_progress'" 
                       decoration-success="state == 'completed'" 
                       decoration-danger="state == 'cancelled'"/>
                <field name="compliance_status" string="Cumplimiento" widget="badge" 
                       decoration-success="compliance_status == 'compliant'" 
                       decoration-warning="compliance_status == 'delayed'" 
                       decoration-danger="compliance_status == 'non_compliant'"/>
            </tree>
        </field>
    </record>

    <!-- VISTA KANBAN DE RECORRIDOS -->
    <record id="view_transport_trip_kanban" model="ir.ui.view">
        <field name="name">transport.trip.kanban</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="trip_direction"/>
                <field name="route_id"/>
                <field name="vehicle_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="compliance_status"/>
                <field name="delay_minutes"/>
                <field name="stop_completion_rate"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3 mb-2 shadow-sm border rounded bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-1">
                                    <strong class="h6 mb-0 text-primary"><field name="name"/></strong>
                                    <field name="trip_direction" widget="badge" 
                                           decoration-info="trip_direction == 'outbound'" 
                                           decoration-warning="trip_direction == 'inbound'"/>
                                </div>
                                <field name="compliance_status" widget="badge" 
                                       decoration-success="compliance_status == 'compliant'" 
                                       decoration-warning="compliance_status == 'delayed'" 
                                       decoration-danger="compliance_status == 'non_compliant'"/>
                            </div>
                            <div class="text-muted small mb-2">
                                <div class="text-truncate fw-semibold text-dark"><i class="fa fa-road text-primary me-1" title="Ruta"/> <field name="route_id"/></div>
                                <div><i class="fa fa-bus text-info me-1" title="Vehículo"/> <field name="vehicle_id"/></div>
                                <div><i class="fa fa-calendar text-secondary me-1" title="Fecha"/> <field name="date"/></div>
                            </div>
                            <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                                <span class="small" t-if="record.delay_minutes.raw_value">
                                    Retraso: <strong class="text-warning"><field name="delay_minutes"/> min</strong>
                                </span>
                                <span class="small" t-if="!record.delay_minutes.raw_value">
                                    <strong class="text-success"><i class="fa fa-check me-1"/>A tiempo</strong>
                                </span>
                                <span class="small">
                                    Paradas: <strong><field name="stop_completion_rate"/>%</strong>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- VISTA CALENDARIO DE RECORRIDOS -->
    <record id="view_transport_trip_calendar" model="ir.ui.view">
        <field name="name">transport.trip.calendar</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Recorridos" 
                      date_start="scheduled_start_time" 
                      date_stop="scheduled_end_time" 
                      color="vehicle_id" 
                      mode="week">
                <field name="name"/>
                <field name="trip_direction"/>
                <field name="route_id"/>
                <field name="vehicle_id"/>
                <field name="compliance_status"/>
            </calendar>
        </field>
    </record>

    <!-- VISTA FORMULARIO ENRIQUECIDA CON MAPA Y UX VISUAL -->
    <record id="view_transport_trip_form" model="ir.ui.view">
        <field name="name">transport.trip.form</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <form string="Recorrido de Transporte Universitario">
                <header>
                    <button name="action_start_trip" 
                            type="object" 
                            string="Iniciar Recorrido" 
                            class="btn btn-primary" 
                            icon="fa-play" 
                            states="draft"/>
                    <button name="action_sync_points_from_traccar" 
                            type="object" 
                            string="Sincronizar GPS Traccar" 
                            class="btn btn-secondary" 
                            icon="fa-refresh" 
                            states="in_progress,completed"/>
                    <button name="action_analyze_trip" 
                            type="object" 
                            string="Evaluar Incidencias Automáticas" 
                            class="btn btn-info text-white" 
                            icon="fa-calculator" 
                            states="in_progress,completed"/>
                    <button name="action_complete_trip" 
                            type="object" 
                            string="Finalizar Recorrido" 
                            class="btn btn-success" 
                            icon="fa-check" 
                            states="in_progress"/>
                    <button name="action_create_return_trip" 
                            type="object" 
                            string="Programar Retorno" 
                            class="btn btn-primary" 
                            icon="fa-exchange" 
                            states="in_progress,completed"/>
                    <button name="action_cancel_trip" 
                            type="object" 
                            string="Cancelar" 
                            states="draft,in_progress"/>
                    <button name="action_reset_draft" 
                            type="object" 
                            string="Volver a Borrador" 
                            states="cancelled"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Puntual" bg_color="bg-success" attrs="{'invisible': [('compliance_status', '!=', 'compliant')]}"/>
                    <widget name="web_ribbon" title="Con Retraso" bg_color="bg-warning" attrs="{'invisible': [('compliance_status', '!=', 'delayed')]}"/>
                    <widget name="web_ribbon" title="Incumplido" bg_color="bg-danger" attrs="{'invisible': [('compliance_status', '!=', 'non_compliant')]}"/>

                    <!-- BOTONES INTELIGENTES (STAT BUTTONS) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_stops" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-flag-checkered">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="stop_check_count"/></span>
                                <span class="o_stat_text">Paradas</span>
                            </div>
                        </button>
                        <button name="action_view_incidents" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-exclamation-triangle">
                            <div class="o_stat_info">
                                <span class="o_stat_value text-danger" attrs="{'invisible': [('incident_count', '=', 0)]}">
                                    <field name="incident_count"/>
                                </span>
                                <span class="o_stat_value" attrs="{'invisible': [('incident_count', '>', 0)]}">
                                    <field name="incident_count"/>
                                </span>
                                <span class="o_stat_text">Incidencias</span>
                            </div>
                        </button>
                        <button name="action_view_points" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-map-marker">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="point_count"/></span>
                                <span class="o_stat_text">Puntos GPS</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Código del Recorrido"/>
                        <h1>
                            <field name="name" class="oe_inline"/>
                            <field name="compliance_status" widget="badge" class="ms-3" 
                                   decoration-success="compliance_status == 'compliant'" 
                                   decoration-warning="compliance_status == 'delayed'" 
                                   decoration-danger="compliance_status == 'non_compliant'"/>
                        </h1>
                    </div>

                    <!-- TARJETAS RESUMEN DE MÉTRICAS RÁPIDAS -->
                    <div class="row text-center my-3 g-2" attrs="{'invisible': [('state', '=', 'draft')]}">
                        <div class="col-md-3">
                            <div class="card p-2 border-0 shadow-sm rounded-3" style="background: linear-gradient(135deg, #fefce8 0%, #fef08a 100%);">
                                <small class="text-warning fw-bold d-block"><i class="fa fa-clock-o me-1"/> Retraso Acumulado</small>
                                <strong class="h4 text-warning fw-bolder mt-1 d-block"><field name="delay_minutes"/> <small class="h6">min</small></strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-2 border-0 shadow-sm rounded-3" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);">
                                <small class="text-success fw-bold d-block"><i class="fa fa-flag-checkered me-1"/> Cumplimiento Paradas</small>
                                <strong class="h4 text-success fw-bolder mt-1 d-block"><field name="stop_completion_rate"/>%</strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-2 border-0 shadow-sm rounded-3" style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);">
                                <small class="text-primary fw-bold d-block"><i class="fa fa-tachometer me-1"/> Distancia Real / Est.</small>
                                <strong class="h4 text-primary fw-bolder mt-1 d-block"><field name="actual_distance"/> / <field name="estimated_distance"/> <small class="h6">km</small></strong>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card p-2 border-0 shadow-sm rounded-3" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
                                <small class="text-dark fw-bold d-block"><i class="fa fa-hourglass-half me-1"/> Duración Real</small>
                                <strong class="h4 text-dark fw-bolder mt-1 d-block"><field name="duration_real_minutes"/> <small class="h6">min</small></strong>
                            </div>
                        </div>
                    </div>

                    <!-- FORMULARIO DE ASIGNACIÓN -->
                    <group>
                        <group string="1. Asignación del Recorrido">
                            <field name="route_id" placeholder="Seleccione la ruta universitaria..." attrs="{'readonly': [('state', 'in', ('completed', 'cancelled'))]}"/>
                            <field name="trip_direction" widget="radio" options="{'horizontal': true}" attrs="{'readonly': [('state', 'in', ('completed', 'cancelled'))]}"/>
                            <field name="vehicle_id" placeholder="Seleccione el bus/vehículo..." attrs="{'readonly': [('state', 'in', ('completed', 'cancelled'))]}"/>
                            <field name="driver_id" placeholder="Conductor asignado..." attrs="{'readonly': [('state', 'in', ('completed', 'cancelled'))]}"/>
                            <field name="date" attrs="{'readonly': [('state', 'in', ('completed', 'cancelled'))]}"/>
                        </group>
                        <group string="2. Control Horario y Programación">
                            <field name="scheduled_start_hour" widget="float_time" required="1" attrs="{'readonly': [('state', 'in', ('completed', 'cancelled'))]}"/>
                            <field name="scheduled_end_hour" widget="float_time" required="1" attrs="{'readonly': [('state', 'in', ('completed', 'cancelled'))]}"/>
                            <field name="actual_start_hour" widget="float_time" attrs="{'readonly': [('state', '=', 'completed')]}"/>
                            <field name="actual_end_hour" widget="float_time" attrs="{'readonly': [('state', '=', 'completed')]}"/>
                            <field name="scheduled_start_time" invisible="1"/>
                            <field name="scheduled_end_time" invisible="1"/>
                            <field name="actual_start_time" invisible="1"/>
                            <field name="actual_end_time" invisible="1"/>
                            <field name="has_deviations" invisible="1"/>
                        </group>
                    </group>

                    <!-- PESTAÑAS: MAPA INTERACTIVO Y DETALLES -->
                    <notebook>
                        <page string="Mapa Interactivo y Puntos de Control" name="map_tracking">
                            <!-- VISOR DE MAPA LEAFLET -->
                            <div class="mb-3">
                                <field name="trip_map_html" widget="html" nolabel="1"/>
                            </div>

                            <label for="stop_check_ids" string="Auditoría de Cumplimiento de Paradas" class="o_form_label h5 mb-2 d-block"/>
                            <field name="stop_check_ids">
                                <tree editable="bottom" 
                                      decoration-success="status == 'visited'" 
                                      decoration-warning="status == 'delayed'" 
                                      decoration-danger="status == 'missed'">
                                    <field name="sequence" string="#"/>
                                    <field name="name"/>
                                    <field name="scheduled_hour" widget="float_time"/>
                                    <field name="scheduled_time" invisible="1"/>
                                    <field name="actual_arrival_time"/>
                                    <field name="min_distance_meters"/>
                                    <field name="delay_minutes"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Incidencias Detectadas" name="incidents">
                            <field name="incident_ids" readonly="1">
                                <tree decoration-danger="severity == 'high'" decoration-warning="severity == 'medium'">
                                    <field name="timestamp"/>
                                    <field name="incident_type" widget="badge"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="name"/>
                                    <field name="delay_minutes"/>
                                    <field name="deviation_distance"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Historial de Coordenadas GPS" name="points">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <button name="action_sync_points_from_traccar" 
                                            type="object" 
                                            string="Obtener Puntos desde Traccar Server" 
                                            class="btn btn-sm btn-outline-primary me-2" 
                                            icon="fa-download"/>
                                </div>
                                <span class="text-muted small">Total registros: <field name="point_count" class="oe_inline"/> coordenadas</span>
                            </div>
                            <field name="point_ids" readonly="1">
                                <tree limit="25">
                                    <field name="timestamp"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="speed"/>
                                    <field name="is_valid" widget="boolean_toggle"/>
                                    <field name="traccar_position_id"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Observaciones y Notas" name="notes">
                            <field name="notes" placeholder="Notas adicionales del recorrido, condiciones climáticas, estado de la vía..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA BÚSQUEDA DE RECORRIDOS -->
    <record id="view_transport_trip_search" model="ir.ui.view">
        <field name="name">transport.trip.search</field>
        <field name="model">transport.trip</field>
        <field name="arch" type="xml">
            <search string="Buscar Recorridos">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="route_id"/>
                <field name="driver_id"/>
                <separator/>
                <filter string="En Curso" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completados" name="completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="Conformes (Puntuales)" name="compliant" domain="[('compliance_status', '=', 'compliant')]"/>
                <filter string="Con Retraso" name="delayed" domain="[('compliance_status', '=', 'delayed')]"/>
                <filter string="Incumplidos" name="non_compliant" domain="[('compliance_status', '=', 'non_compliant')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Ruta" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Vehículo" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Cumplimiento" name="group_compliance" context="{'group_by': 'compliance_status'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACCIÓN DE VENTANA PARA RECORRIDOS -->
    <record id="action_transport_trip" model="ir.actions.act_window">
        <field name="name">Recorridos y Asignaciones</field>
        <field name="res_model">transport.trip</field>
        <field name="view_mode">tree,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_transport_trip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Programe un nuevo recorrido de bus universitario.
            </p>
            <p>
                Asigne un vehículo y conductor a una ruta en una fecha y horario específicos.
            </p>
        </field>
    </record>
</odoo>
