<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA ÁRBOL (TREE) DE RUTAS -->
    <record id="view_transport_route_tree" model="ir.ui.view">
        <field name="name">transport.route.tree</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <tree string="Rutas de Transporte Universitario">
                <field name="code"/>
                <field name="name"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="estimated_distance" sum="Total km"/>
                <field name="estimated_duration"/>
                <field name="stop_count"/>
                <field name="trip_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- VISTA FORMULARIO DE RUTAS CON MAPA -->
    <record id="view_transport_route_form" model="ir.ui.view">
        <field name="name">transport.route.form</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <form string="Ruta de Transporte Universitario">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <widget name="web_ribbon" title="Activa" bg_color="bg-success" attrs="{'invisible': [('active', '=', False)]}"/>

                    <div class="oe_button_box" name="button_box">
                        <button type="object" 
                                name="action_view_stops" 
                                class="oe_stat_button" 
                                icon="fa-flag-checkered">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="stop_count"/></span>
                                <span class="o_stat_text">Paradas</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="code" string="Código de Ruta"/>
                        <h1>
                            <field name="code" placeholder="Ej. UTA-R01" class="oe_inline"/>
                        </h1>
                        <label for="name" string="Nombre Descriptivo"/>
                        <h2>
                            <field name="name" placeholder="Ej. Ruta 1: Campus Huachi - Campus Ingahurco"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Trayecto y Distancias">
                            <field name="origin"/>
                            <field name="destination"/>
                            <field name="estimated_distance"/>
                            <field name="estimated_duration"/>
                        </group>
                        <group string="Parámetros de Tolerancia">
                            <field name="allowed_deviation_meters"/>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Mapa del Trazado y Paradas" name="map_stops">
                            <!-- MAPA INTERACTIVO DE LA RUTA -->
                            <div class="mb-3">
                                <field name="route_map_html" widget="html" nolabel="1"/>
                            </div>

                            <label for="stop_ids" string="Puntos de Control / Paradas Georreferenciadas" class="o_form_label h5 mb-2 d-block"/>
                            <field name="stop_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="expected_offset_minutes"/>
                                    <field name="proximity_radius"/>
                                    <field name="time_tolerance"/>
                                    <field name="is_mandatory"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Coordenadas del Trazado Base" name="coordinates">
                            <group>
                                <field name="reference_coordinates" widget="text" placeholder="[[-1.2687,-78.6258],[-1.2605,-78.6242],...]"/>
                            </group>
                        </page>

                        <page string="Notas y Descripción" name="notes">
                            <field name="description" placeholder="Información adicional sobre la ruta, paradas y consideraciones operativas..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA BÚSQUEDA DE RUTAS -->
    <record id="view_transport_route_search" model="ir.ui.view">
        <field name="name">transport.route.search</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <search string="Buscar Rutas">
                <field name="name"/>
                <field name="code"/>
                <field name="origin"/>
                <field name="destination"/>
                <filter string="Activas" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- VISTA KANBAN DE RUTAS -->
    <record id="view_transport_route_kanban" model="ir.ui.view">
        <field name="name">transport.route.kanban</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="estimated_distance"/>
                <field name="estimated_duration"/>
                <field name="stop_count"/>
                <field name="trip_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-3 mb-2 shadow-sm border rounded bg-white oe_kanban_color_#{kanban_getcolor(record.color.raw_value)}">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge rounded-pill bg-primary px-2 py-1"><field name="code"/></span>
                                <span class="text-muted small">
                                    <i class="fa fa-flag-checkered text-cyan me-1" title="Paradas"/> <field name="stop_count"/> Paradas
                                </span>
                            </div>
                            <h5 class="fw-bold text-dark mb-1"><field name="name"/></h5>
                            <div class="text-muted small my-2 py-1 border-top border-bottom d-flex align-items-center justify-content-between">
                                <span><i class="fa fa-map-marker text-success me-1" title="Origen"/> <field name="origin"/></span>
                                <i class="fa fa-long-arrow-right text-muted mx-2" title="Hacia"/>
                                <span><i class="fa fa-map-marker text-danger me-1" title="Destino"/> <field name="destination"/></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-1 text-muted small">
                                <span><i class="fa fa-road me-1" title="Distancia"/> <field name="estimated_distance"/> km</span>
                                <span><i class="fa fa-clock-o me-1" title="Tiempo"/> <field name="estimated_duration"/> min</span>
                                <span><i class="fa fa-bus text-info me-1" title="Viajes"/> <field name="trip_count"/> Viajes</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACCIÓN DE VENTANA PARA RUTAS -->
    <record id="action_transport_route" model="ir.actions.act_window">
        <field name="name">Gestión de Rutas</field>
        <field name="res_model">transport.route</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_transport_route_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una nueva ruta de transporte universitario.
            </p>
            <p>
                Defina el origen, destino, puntos de control georreferenciados y tiempos estimados de viaje.
            </p>
        </field>
    </record>
</odoo>
