<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- VISTA ÁRBOL (TREE) DE RUTAS -->
    <record id="view_transport_route_tree" model="ir.ui.view">
        <field name="name">transport.route.tree</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <tree string="Rutas de Transporte Universitario">
                <field name="code"/>
                <field name="name"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="outbound_distance" sum="Total km Ida"/>
                <field name="return_distance" sum="Total km Regreso"/>
                <field name="estimated_duration"/>
                <field name="return_duration"/>
                <field name="layover_duration"/>
                <field name="stop_count"/>
                <field name="trip_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- VISTA FORMULARIO DE RUTAS CON MAPA -->
    <record id="view_transport_route_form" model="ir.ui.view">
        <field name="name">transport.route.form</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <form string="Ruta de Transporte Universitario">
                <header>
                    <button name="action_open_map_editor" type="object" string="Diseñar Trazado en Pantalla Completa" class="btn-primary" icon="fa-pencil"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <widget name="web_ribbon" title="Activa" bg_color="bg-success" attrs="{'invisible': [('active', '=', False)]}"/>

                    <div class="oe_button_box" name="button_box">
                        <button type="object" 
                                name="action_view_stops" 
                                class="oe_stat_button" 
                                icon="fa-flag-checkered">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="stop_count"/></span>
                                <span class="o_stat_text">Paradas</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="code" string="Código de Ruta"/>
                        <h1>
                            <field name="code" placeholder="Ej. UTA-R01" class="oe_inline"/>
                        </h1>
                        <label for="name" string="Nombre Descriptivo"/>
                        <h2>
                            <field name="name" placeholder="Ej. Ruta 1: Campus Huachi - Campus Ingahurco"/>
                        </h2>
                    </div>

                    <group>
                        <group string="🔵 Tramo de IDA (Salida)">
                            <field name="origin" string="Origen Ida (1er Vértice)"/>
                            <field name="destination" string="Destino Ida (Último Vértice)"/>
                            <field name="outbound_distance" readonly="1"/>
                            <label for="estimated_duration" string="Duración Estimada Ida"/>
                            <div class="o_row">
                                <field name="estimated_duration"/>
                                <span class="text-muted">min (incluye paradas)</span>
                            </div>
                        </group>
                        <group string="🟠 Tramo de REGRESO (Retorno)">
                            <field name="origin_return" string="Origen Retorno (1er Vértice)"/>
                            <field name="destination_return" string="Destino Retorno (Último Vértice)"/>
                            <field name="return_distance" readonly="1"/>
                            <label for="return_duration" string="Duración Estimada Retorno"/>
                            <div class="o_row">
                                <field name="return_duration"/>
                                <span class="text-muted">min (incluye paradas)</span>
                            </div>
                            <field name="layover_duration" string="Espera en Cabecera (min)"/>
                        </group>
                    </group>
                    <group string="Parámetros Globales y Tolerancia">
                        <group>
                            <field name="estimated_distance" readonly="1"/>
                            <field name="allowed_deviation_meters"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Diseñador y Trazado de Ruta" name="map_stops">
                            <div class="alert alert-info py-2 px-3 small d-flex align-items-center justify-content-between mb-2" role="status">
                                <div>
                                    <i class="fa fa-info-circle me-1" title="Información"></i>
                                    <strong>Diseñador Bidireccional:</strong> Traza la <strong>Línea Azul (Ida)</strong> y la <strong>Línea Naranja (Regreso)</strong> de forma independiente sobre el mapa. El primer y último vértice de cada línea determinan automáticamente el <em>Punto de Origen</em> y <em>Destino</em>. Al guardar, las coordenadas quedan registradas para verificar desvíos según el sentido del viaje.
                                </div>
                            </div>

                            <!-- MAPA INTERACTIVO DE LA RUTA -->
                            <div class="mb-3">
                                <field name="route_map_html" widget="html" nolabel="1"/>
                            </div>

                            <label for="stop_ids" string="Puntos de Control / Paradas Georreferenciadas" class="o_form_label h5 mb-2 d-block"/>
                            <field name="stop_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="stop_direction"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="expected_offset_minutes"/>
                                    <field name="proximity_radius"/>
                                    <field name="is_mandatory"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Coordenadas del Trazado Base" name="coordinates">
                            <group>
                                <field name="reference_coordinates" widget="text" string="Coordenadas Ida (Azul)"/>
                                <field name="return_coordinates" widget="text" string="Coordenadas Regreso (Naranja)"/>
                            </group>
                        </page>

                        <page string="Notas y Descripción" name="notes">
                            <field name="description" placeholder="Información adicional sobre la ruta, paradas y consideraciones operativas..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA BÚSQUEDA DE RUTAS -->
    <record id="view_transport_route_search" model="ir.ui.view">
        <field name="name">transport.route.search</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <search string="Buscar Rutas">
                <field name="name"/>
                <field name="code"/>
                <field name="origin"/>
                <field name="destination"/>
                <filter string="Activas" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- VISTA KANBAN DE RUTAS -->
    <record id="view_transport_route_kanban" model="ir.ui.view">
        <field name="name">transport.route.kanban</field>
        <field name="model">transport.route</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="outbound_distance"/>
                <field name="return_distance"/>
                <field name="estimated_duration"/>
                <field name="return_duration"/>
                <field name="layover_duration"/>
                <field name="stop_count"/>
                <field name="trip_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3 mb-2 shadow-sm border rounded bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge rounded-pill text-white px-2 py-1" style="background-color: #1d4ed8; color: #ffffff;"><field name="code"/></span>
                                <span class="small fw-semibold" style="color: #475569;">
                                    <i class="fa fa-flag-checkered text-primary me-1" title="Paradas"/> <field name="stop_count"/> Paradas
                                </span>
                            </div>
                            <h5 class="fw-bold text-dark mb-1"><field name="name"/></h5>
                            <div class="small my-2 py-2 border-top border-bottom" style="color: #334155;">
                                <div class="d-flex align-items-center justify-content-between gap-1 mb-1">
                                    <span class="text-truncate"><span class="badge text-white me-1" style="background-color: #0284c7; color: #ffffff;">IDA</span> <field name="origin"/></span>
                                    <i class="fa fa-long-arrow-right mx-1" style="color: #64748b;" title="Hacia"/>
                                    <span class="text-truncate"><field name="destination"/></span>
                                </div>
                                <div class="d-flex justify-content-between fw-semibold" style="color: #475569;">
                                    <span><i class="fa fa-road me-1 text-primary" title="Distancia Ida"/> <field name="outbound_distance"/> km</span>
                                    <span><i class="fa fa-clock-o me-1 text-info" title="Tiempo Ida"/> <field name="estimated_duration"/> min</span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-1 small" style="color: #475569;">
                                <span><span class="badge bg-warning text-dark me-1">REGRESO</span> <field name="return_distance"/> km (<field name="return_duration"/> min)</span>
                                <span t-if="record.layover_duration.raw_value"><i class="fa fa-coffee me-1" title="Espera"/> <field name="layover_duration"/> min</span>
                                <span class="fw-bold text-dark"><i class="fa fa-bus text-info me-1" title="Viajes"/> <field name="trip_count"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACCIÓN DE VENTANA PARA RUTAS -->
    <record id="action_transport_route" model="ir.actions.act_window">
        <field name="name">Gestión de Rutas</field>
        <field name="res_model">transport.route</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_transport_route_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree una nueva ruta de transporte universitario.
            </p>
            <p>
                Defina el origen, destino, puntos de control georreferenciados y tiempos estimados de viaje.
            </p>
        </field>
    </record>
</odoo>
